map_table your_instance_name (
	.clock(clock)					,//input clock
	.data(data)						,//input [7:0] data
	.rdaddress(rdaddress)				,//input [7:0] rdaddress
	.wraddress(wraddress)				,//input [7:0] wraddress
	.wren(wren)					,//input wren
	.q(q)							//output	[7:0] q
);

